PORT=8787

# mock | xai | openrouter | openai-compatible
AI_PROVIDER=mock

# xAI / Grok (Responses API)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# OpenRouter (OpenAI-compatible Chat Completions)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4
OPENROUTER_APP_URL=https://github.com/Mtzallqmy/Agalqami
OPENROUTER_APP_NAME=Alalqami Agent

# Generic OpenAI-compatible endpoint.
# Examples: OpenAI https://api.openai.com/v1, LM Studio/vLLM/local gateways.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-5
